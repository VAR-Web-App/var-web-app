rules_version = '2';

// Multi-tenant isolation enforced at the rules layer. Reads + writes only
// succeed if the requesting user's profile.org_ref matches the record's
// org_ref. The user profile itself lives at users/{uid} and is read once
// to resolve the caller's org_ref — see helper below.
//
// Deploy: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ─────────────────────────────────────────────────

    // Read the caller's org_ref from their user profile. Cached per-rule-
    // evaluation; safe to call multiple times. Returns null if missing.
    function callerOrgRef() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.org_ref;
    }

    // True when the record's org_ref matches the caller's.
    function ownsByOrg() {
      return request.auth != null
        && resource != null
        && resource.data.org_ref == callerOrgRef();
    }

    // True for create operations — checks the *new* doc's org_ref instead
    // of resource.data (which doesn't exist yet on create).
    function creatingForOwnOrg() {
      return request.auth != null
        && request.resource.data.org_ref == callerOrgRef();
    }

    // ── per-collection rules ────────────────────────────────────

    // Org doc: only the owner can read/write. Members read happens via
    // their own user profile, not via reading the org doc directly.
    match /orgs/{orgId} {
      allow read: if request.auth != null
                  && (request.auth.uid == orgId
                      || (resource != null && resource.data.owner_uid == request.auth.uid));
      allow create: if request.auth != null
                    && request.auth.uid == orgId
                    && request.resource.data.owner_uid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.owner_uid == request.auth.uid;
    }

    // User profile: each user can read/write their own. org_ref is the ONLY
    // thing that gates cross-tenant access, so it can't be freely written —
    // otherwise anyone could read a victim's org_ref (exposed in public link
    // docs) and self-assign into that tenant. It may only be set to your
    // personal org (your uid) or to an org that actually invited your email.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.org_ref == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && (
          request.resource.data.org_ref == resource.data.org_ref
          || request.resource.data.org_ref == uid
          || (
            request.auth.token.email != null
            && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
            && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.org_ref
               == request.resource.data.org_ref
          )
        );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Deals: org-scoped.
    match /deals/{dealId} {
      allow read, update, delete: if ownsByOrg();
      allow create: if creatingForOwnOrg();
    }

    // Accounts, contacts, distributors: same shape.
    match /accounts/{id}    { allow read, update, delete: if ownsByOrg(); allow create: if creatingForOwnOrg(); }
    match /contacts/{id}    { allow read, update, delete: if ownsByOrg(); allow create: if creatingForOwnOrg(); }
    match /distributors/{id}{ allow read, update, delete: if ownsByOrg(); allow create: if creatingForOwnOrg(); }

    // Client sign links: PUBLIC collection. A random token serves as the
    // doc ID; whoever has the token (the homeowner the GC emailed) can
    // read the proposal contents and sign it without an account.
    //
    // - allow read: public (the trust boundary is the unguessable token)
    // - allow create: only by an authed GC for their own org
    // - allow update: ONLY to write the signature fields; everything else
    //   stays a frozen snapshot. Either:
    //     (a) the public client adds signed_by_name/signed_at, OR
    //     (b) the authed GC marks synced_to_deal once they've picked up
    //         the signature into the deal record.
    match /client_sign_links/{token} {
      // get-by-token is the trust boundary; list must be denied so nobody can
      // enumerate the collection and dump every org's signed proposals.
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.token == token
        && request.resource.data.org_ref == callerOrgRef();
      allow update: if (
        // Public client signing: only signature fields touched, doc was
        // not previously signed (anti-tamper).
        resource.data.signed_at == null
        && request.resource.data.signed_at is string
        && request.resource.data.signed_by_name is string
        && request.resource.data.deal_ref == resource.data.deal_ref
        && request.resource.data.org_ref == resource.data.org_ref
        && request.resource.data.token == resource.data.token
        && request.resource.data.contract_amount == resource.data.contract_amount
      ) || (
        // GC sync flag (authed): flips synced_to_deal after pulling the
        // signature into the deal record.
        request.auth != null
        && resource.data.org_ref == callerOrgRef()
      );
      // Once signed, no deletion (audit trail).
      allow delete: if request.auth != null
        && resource.data.org_ref == callerOrgRef()
        && resource.data.signed_at == null;
    }

    // Sub schedule links: PUBLIC collection, same trust model as
    // client_sign_links. The token (doc ID) is the trust boundary — a
    // sub opens /s/{token} from their schedule text with no account.
    // The doc holds a read-only snapshot of that sub's assignments.
    //
    // - allow read: public
    // - allow create/update/delete: only the authed builder, own org
    match /sub_schedule_links/{token} {
      // get-by-token only; deny list to prevent cross-tenant enumeration.
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.token == token
        && request.resource.data.org_ref == callerOrgRef();
      allow update, delete: if request.auth != null
        && resource.data.org_ref == callerOrgRef();
    }

    // Designer links (Builder vertical): a no-login page at /d/{token}
    // where an interior designer curates selection options for one
    // project. Same trust model as sub_schedule_links — the token doc is
    // public-read, gated only by the unguessable token; only the authed
    // builder (own org) can mint/update/delete it. The designer's actual
    // reads + writes to project_selections go through /api/designer/*
    // (admin SDK) after the server verifies the token.
    match /designer_links/{token} {
      // get-by-token is public (the designer opens /d/{token} with no login).
      // list is allowed only to the authed builder, scoped to their own org —
      // createOrGetDesignerLink queries by org_ref so this is satisfiable
      // without exposing other tenants' links to enumeration.
      allow get: if true;
      allow list: if request.auth != null
        && resource.data.org_ref == callerOrgRef();
      allow create: if request.auth != null
        && request.resource.data.token == token
        && request.resource.data.org_ref == callerOrgRef();
      allow update, delete: if request.auth != null
        && resource.data.org_ref == callerOrgRef();
    }

    // Client portal links: PUBLIC no-login homeowner portal at /portal/{token}.
    // Same trust model as designer_links — get-by-token public, list scoped to
    // the authed builder's own org (createOrGetClientPortalLink queries by
    // org_ref). All homeowner reads/writes to the project go through
    // /api/portal/* (admin SDK) after the token is verified.
    match /client_portal_links/{token} {
      allow get: if true;
      allow list: if request.auth != null
        && resource.data.org_ref == callerOrgRef();
      allow create: if request.auth != null
        && request.resource.data.token == token
        && request.resource.data.org_ref == callerOrgRef();
      allow update, delete: if request.auth != null
        && resource.data.org_ref == callerOrgRef();
    }

    // Settings: keyed by org_ref directly. Each user can only access their
    // own org's settings doc.
    match /settings/{orgRef} {
      allow read, write: if request.auth != null && orgRef == callerOrgRef();
    }

    // Team invites: an org owner invites a teammate by email. The doc id is the
    // invitee's lowercased email. The invitee reads their own invite (matched on
    // their auth email claim) and accepts by repointing users/{uid}.org_ref at
    // the invited org. Owners list/create/revoke invites for their own org only.
    match /invites/{email} {
      allow read: if request.auth != null
                  && (request.auth.token.email == email
                      || (resource != null
                          && resource.data.org_ref == callerOrgRef()));
      allow create, update: if request.auth != null
                  && request.resource.data.org_ref == callerOrgRef();
      allow delete: if request.auth != null
                  && resource.data.org_ref == callerOrgRef();
    }

    // Attachments are tied to a deal, not an org directly. We check the
    // caller's org against the parent deal's org.
    match /attachments/{attId} {
      function dealOrg() {
        return get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref;
      }
      function newDealOrg() {
        return get(/databases/$(database)/documents/deals/$(request.resource.data.deal_ref)).data.org_ref;
      }
      allow read, update, delete: if request.auth != null && dealOrg() == callerOrgRef();
      allow create: if request.auth != null && newDealOrg() == callerOrgRef();
    }

    // Quote lines: same shape as attachments — gate on the parent deal's
    // org_ref. Each line stores org_ref redundantly so it shows up in
    // org-scoped queries without a parent fetch, but the rules check the
    // parent deal as the source of truth.
    match /quote_lines/{lineId} {
      function dealOrg() {
        return get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref;
      }
      function newDealOrg() {
        return get(/databases/$(database)/documents/deals/$(request.resource.data.deal_ref)).data.org_ref;
      }
      allow read, update, delete: if request.auth != null && dealOrg() == callerOrgRef();
      allow create: if request.auth != null && newDealOrg() == callerOrgRef();
    }

    // Project milestones (Builder vertical): one milestone per draw.
    // Same gate-on-parent-deal pattern as quote_lines / attachments, plus an
    // org-scoped read branch so the cross-project queries (the /schedule
    // conflict view via listAllMilestonesForOrg, sub reliability) are
    // authorized — a deal_ref-only rule rejects an org_ref-filtered query.
    // Milestones carry org_ref, so ownsByOrg() covers it; writes stay
    // gated on the parent deal.
    match /project_milestones/{msId} {
      function dealOrg() {
        return get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref;
      }
      function newDealOrg() {
        return get(/databases/$(database)/documents/deals/$(request.resource.data.deal_ref)).data.org_ref;
      }
      allow read: if ownsByOrg()
                  || (request.auth != null && dealOrg() == callerOrgRef());
      allow update, delete: if request.auth != null && dealOrg() == callerOrgRef();
      allow create: if request.auth != null && newDealOrg() == callerOrgRef();
    }

    // Project photos (Builder vertical): phase-tagged build photos.
    match /project_photos/{photoId} {
      function dealOrg() {
        return get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref;
      }
      function newDealOrg() {
        return get(/databases/$(database)/documents/deals/$(request.resource.data.deal_ref)).data.org_ref;
      }
      allow read, update, delete: if request.auth != null && dealOrg() == callerOrgRef();
      allow create: if request.auth != null && newDealOrg() == callerOrgRef();
    }

    // Project RFQs (Builder vertical): subcontractor bid requests.
    match /project_rfqs/{rfqId} {
      function dealOrg() {
        return get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref;
      }
      function newDealOrg() {
        return get(/databases/$(database)/documents/deals/$(request.resource.data.deal_ref)).data.org_ref;
      }
      allow read, update, delete: if request.auth != null && dealOrg() == callerOrgRef();
      allow create: if request.auth != null && newDealOrg() == callerOrgRef();
    }

    // Sub acknowledgments: written ONLY by the server (admin SDK) after
    // /api/sub/acknowledge validates the token. The GC reads them to
    // surface "sub confirmed" / "sub flagged a conflict" badges. No
    // client write path — admin SDK bypasses these rules.
    match /sub_acknowledgments/{ackId} {
      // Read via org_ref directly OR the parent deal's org, so the deal_ref-
      // scoped query (listSubAcknowledgmentsByDeal) isn't rejected by the
      // "rules aren't filters" trap. Writes are server-only (admin route).
      allow read: if request.auth != null
                  && (resource.data.org_ref == callerOrgRef()
                      || get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref == callerOrgRef());
      allow write: if false;
    }

    // Invoices (Track 2: Financial Flywheel): parsed invoice records
    // from forwarded emails or uploaded documents. Org-scoped directly
    // (not deal-scoped) since pending invoices may not yet be matched
    // to a project.
    match /invoices/{invId} {
      function dealOrg() {
        return get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref;
      }
      // Two access patterns:
      //  - org-scoped: pending/unmatched invoices listed by org_ref (Inbox).
      //    ownsByOrg() authorizes that query directly.
      //  - deal-scoped: a project's invoices listed by deal_ref (Finances
      //    tab). An org_ref rule alone rejects a deal_ref-only query, so we
      //    also allow via a parent-deal get() — which authorizes the query
      //    per-document, the same pattern as payments/quote_lines. Ordered
      //    so ownsByOrg() short-circuits (no get()) for the org-wide list,
      //    where invoices may not have a deal_ref yet.
      allow read: if ownsByOrg()
                  || (request.auth != null && dealOrg() == callerOrgRef());
      allow update, delete: if ownsByOrg();
      allow create: if creatingForOwnOrg();
    }

    // Payments (money in/out ledger): deal-scoped bookkeeping records —
    // client deposits in, sub/supplier payouts out. The Payment doc has
    // no org_ref of its own (see types/index.ts), so gate on the parent
    // deal's org_ref, the same pattern as quote_lines / project_milestones
    // / project_change_orders. The Finances tab lists these by deal_ref.
    match /payments/{payId} {
      function dealOrg() {
        return get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref;
      }
      function newDealOrg() {
        return get(/databases/$(database)/documents/deals/$(request.resource.data.deal_ref)).data.org_ref;
      }
      allow read, update, delete: if request.auth != null && dealOrg() == callerOrgRef();
      allow create: if request.auth != null && newDealOrg() == callerOrgRef();
    }

    // Project selections (Builder vertical): client-facing priced
    // option picks (countertops, flooring, etc.) with allowance tracking
    // and auto-CO on over-allowance.
    match /project_selections/{selId} {
      function dealOrg() {
        return get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref;
      }
      function newDealOrg() {
        return get(/databases/$(database)/documents/deals/$(request.resource.data.deal_ref)).data.org_ref;
      }
      allow read, update, delete: if request.auth != null && dealOrg() == callerOrgRef();
      allow create: if request.auth != null && newDealOrg() == callerOrgRef();
    }

    // Project change orders (Builder vertical): scope/cost changes
    // during construction with client approval.
    match /project_change_orders/{coId} {
      function dealOrg() {
        return get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref;
      }
      function newDealOrg() {
        return get(/databases/$(database)/documents/deals/$(request.resource.data.deal_ref)).data.org_ref;
      }
      allow read, update, delete: if request.auth != null && dealOrg() == callerOrgRef();
      allow create: if request.auth != null && newDealOrg() == callerOrgRef();
    }

    // Per-deal Requests / asks (paper-trail log). Same deal-parent-org
    // scoping as change orders.
    match /project_requests/{reqId} {
      function dealOrg() {
        return get(/databases/$(database)/documents/deals/$(resource.data.deal_ref)).data.org_ref;
      }
      function newDealOrg() {
        return get(/databases/$(database)/documents/deals/$(request.resource.data.deal_ref)).data.org_ref;
      }
      allow read, update, delete: if request.auth != null && dealOrg() == callerOrgRef();
      allow create: if request.auth != null && newDealOrg() == callerOrgRef();
    }

    // Inbound email (forward-in). Written by the admin webhook (/api/email/inbound);
    // org-scoped reads for the app. org_ref is on the doc directly.
    match /email_messages/{msgId} {
      allow read, update, delete: if request.auth != null && resource.data.org_ref == callerOrgRef();
    }

    // Connected mailboxes (Unipile). Written admin-only by the notify
    // webhook; org members read/delete their own (delete = disconnect).
    match /email_accounts/{accountId} {
      allow read, delete: if request.auth != null && resource.data.org_ref == callerOrgRef();
    }
  }
}
